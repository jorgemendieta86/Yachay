---
import '../styles/global.css';
const { title = 'Laboratorio de Analogías' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Plataforma interactiva de razonamiento verbal para aprender analogías." />
    <meta name="theme-color" content="#fff9ef" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="./img/insignia.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
