---
import MainLayout from '../layouts/MainLayout.astro';
import { analogies } from '../data/analogies';
import { adjectives } from '../data/adjectives';
---

<MainLayout>
  <main class="app-shell">
    <div class="sun-orb" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <header class="topbar">
       <a class="brand" href="./" aria-label="Ir al inicio">
         <img src="./img/insignia.png" alt="Insignia de la Institución Educativa José Carlos Mariátegui" />
        <span><strong>YACHAY</strong><small>laboratorio de palabras</small></span>
      </a>
      <button class="sound-button" id="sound-toggle" type="button" aria-pressed="false">
        <span class="sound-icon" aria-hidden="true">♫</span><span id="sound-label">Ambiente sonoro</span>
      </button>
    </header>

    <section class="view intro-view" id="intro-view" aria-labelledby="intro-title">
      <div class="intro-copy reveal">
        <p class="eyebrow">COMUNICACIÓN · RAZONAMIENTO VERBAL</p>
        <h1 id="intro-title">Conecta las ideas.<br /><em>Descubre la relación.</em></h1>
        <p class="intro-lead">Entrena tu mirada para encontrar lo que une a dos palabras. Sin prisa, con curiosidad y a tu propio ritmo.</p>
          <div class="stat-row" aria-label="Características de la actividad">
           <span><b>2</b> desafíos disponibles</span><span><b>3</b> niveles</span>
        </div>
      </div>
      <div class="start-card reveal delayed">
        <div class="card-marker">01 <span>/ listo para empezar</span></div>
         <h2>¿Cómo te llamas?</h2>
         <p>Elige un recorrido y tu nombre aparecerá en el resultado final.</p>
         <label for="student-name" class="sr-only">Nombre del estudiante</label>
         <input id="student-name" type="text" maxlength="30" placeholder="Escribe tu nombre" autocomplete="name" />
         <fieldset class="challenge-picker">
           <legend>Selecciona el desafío</legend>
           <label><input type="radio" name="challenge" value="analogies" /> <span>Analogías</span></label>
           <label><input type="radio" name="challenge" value="adjectives" /> <span>Adjetivos</span></label>
         </fieldset>
         <p class="challenge-selection-status" id="challenge-selection-status" role="status" aria-live="polite">Selecciona un desafío para continuar.</p>
         <button class="primary-button hidden" id="start-button" type="button">Comenzar recorrido <span>→</span></button>
      </div>
    </section>

    <section class="view history-view" id="history-view" aria-labelledby="history-title">
      <div class="history-heading">
        <div>
          <p class="eyebrow">SEGUIMIENTO</p>
          <h2 id="history-title">Historial de resultados</h2>
        </div>
        <label for="history-student-filter">Filtrar por estudiante
          <select id="history-student-filter">
            <option value="">Todos los estudiantes</option>
          </select>
        </label>
      </div>
      <p class="history-status" id="history-status" role="status" aria-live="polite"></p>
      <div class="history-table-wrap">
        <table class="history-table">
          <caption class="sr-only">Resultados guardados de los estudiantes</caption>
          <thead>
             <tr><th scope="col">Estudiante</th><th scope="col">Desafío</th><th scope="col">Aciertos</th><th scope="col">Errores</th><th scope="col">Nivel</th><th scope="col">Fecha</th></tr>
          </thead>
          <tbody id="history-list"></tbody>
        </table>
      </div>
    </section>

    <section class="view quiz-view hidden" id="quiz-view" aria-labelledby="question-title">
      <div class="quiz-topline">
         <div><span class="eyebrow"><span id="challenge-label">DESAFÍO</span> <span id="question-number">01</span></span><span class="difficulty-pill" id="difficulty-pill">BÁSICO</span></div>
        <div class="score-box"><span>PUNTOS</span><strong id="score">000</strong></div>
      </div>
       <div class="progress-track" id="progress-track" role="progressbar" aria-label="Progreso de la actividad" aria-valuemin="0" aria-valuemax={analogies.length} aria-valuenow="0"><div id="progress-bar"></div></div>
      <div class="quiz-layout">
        <aside class="quiz-aside">
           <p class="type-label" id="type-label">RELACIÓN</p><h2 id="analogy-type">Sinonimia</h2>
           <div class="aside-tip"><span>✦</span><p id="tip-text"><strong>Observa antes de elegir.</strong><br />Busca qué relación existe entre el primer par.</p></div>
          <div class="live-stats"><div><strong id="correct-count">0</strong><span>aciertos</span></div><div><strong id="streak-count">0</strong><span>racha</span></div></div>
        </aside>
        <div class="question-card">
          <p class="question-instruction">Completa la analogía</p>
          <h1 id="question-title">Feliz es a alegre como triste es a...</h1>
          <div class="options-grid" id="options-list"></div>
          <div class="feedback hidden" id="feedback" role="status" aria-live="polite"><div class="feedback-icon" id="feedback-icon">✓</div><div><strong id="feedback-title">¡Muy bien!</strong><p id="feedback-text"></p></div></div>
          <button class="next-button hidden" id="next-button" type="button">Siguiente desafío <span>→</span></button>
        </div>
      </div>
    </section>

    <section class="view results-view hidden" id="results-view" aria-labelledby="results-title">
      <div class="results-badge">✦</div>
        <p class="eyebrow">RECORRIDO COMPLETADO · <span id="result-challenge">ANALOGÍAS</span></p>
       <h1 id="results-title">¡Buen trabajo, <span id="result-name">estudiante</span>!</h1>
       <p class="results-subtitle">Cada respuesta fue una nueva forma de mirar.</p>
       <p class="save-status" id="save-status" role="status" aria-live="polite"></p>
       <p class="best-result hidden" id="best-result" role="status">Este es tu mejor resultado hasta ahora.</p>
      <div class="results-panel">
        <div class="big-score"><span>PUNTAJE FINAL</span><strong id="final-score">0</strong><small>puntos</small></div>
        <div class="result-metrics"><div><strong id="final-correct">0</strong><span>aciertos</span></div><div><strong id="final-percent">0%</strong><span>precisión</span></div><div><strong id="final-streak">0</strong><span>mejor racha</span></div></div>
      </div>
      <div class="result-actions"><button class="primary-button" id="restart-button" type="button">Volver a intentarlo <span>↻</span></button><button class="secondary-button" id="print-button" type="button">Imprimir resultado</button></div>
    </section>
    <footer><span>I.E. José Carlos Mariátegui</span><span>Socchabamba · Ayabaca</span></footer>
  </main>

  <script is:inline define:vars={{ analogies, adjectives }}>
      const challengeBanks = { analogies, adjectives };
      let selectedChallenge = localStorage.getItem('yachay-challenge') || 'analogies';
      const getChallenge = () => document.querySelector('input[name="challenge"]:checked')?.value || '';
      const challengeName = (type) => type === 'adjectives' ? 'Adjetivos' : 'Analogías';
      let allQuestions = challengeBanks[selectedChallenge] || analogies;
      let totalQuestions = allQuestions.length;
      const errorThreshold = 15;
      const historyKey = 'yachay-results';
      const recentQuestionsKey = () => `yachay-recent-questions-${selectedChallenge}`;
      const resultsEndpoint = 'https://script.google.com/macros/s/AKfycbx2rb6uOeRqPvdicauu_q3O114DjExI0Tv3SMqRzm2h5-5y9c6MGdF2djLjfEp6expPIA/exec';
      let activeQuestions = [], current = 0, score = 0, correct = 0, streak = 0, bestStreak = 0, answered = false;
      let audioContext, masterGain, soundOn = false;
      const $ = (id) => document.getElementById(id);
      const intro = $('intro-view'), history = $('history-view'), quiz = $('quiz-view'), results = $('results-view');
      const shuffle = (items) => [...items].sort(() => Math.random() - 0.5);
      const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
      function getHistory() {
        try {
          const saved = JSON.parse(localStorage.getItem(historyKey) || '[]');
          return Array.isArray(saved) ? saved : [];
        } catch {
          return [];
        }
      }
      function formatResultDate(value) {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Sin fecha' : date.toLocaleString('es-PE', { dateStyle: 'short', timeStyle: 'short' });
      }
      function normalizeStudentName(name) {
        return String(name).trim().toLocaleLowerCase('es');
      }
       function getLatestStudentResult(name) {
         const student = normalizeStudentName(name);
         return getHistory()
           .filter((item) => normalizeStudentName(item.nombre) === student && (item.desafio || 'analogies') === selectedChallenge)
          .sort((first, second) => new Date(second.fecha) - new Date(first.fecha))[0];
      }
       function getQuestionPlan(name) {
         const latestResult = getLatestStudentResult(name);
         if (selectedChallenge === 'adjectives') return { 'Básico': 20, 'Intermedio': 15, 'Avanzado': 15 };
         return latestResult && Number(latestResult.errores) >= errorThreshold
          ? { 'Básico': 20, 'Intermedio': 10 }
          : { 'Básico': 10, 'Intermedio': 10, 'Avanzado': 10 };
      }
      function arrangeOptions(items) {
        const answerPositions = shuffle(items.map((item, index) => index % item.options.length));
        return items.map((item, index) => {
          const correctOption = item.options[item.answer];
          const distractors = shuffle(item.options.filter((_, optionIndex) => optionIndex !== item.answer));
          const options = [...distractors];
          const answer = answerPositions[index];
          options.splice(answer, 0, correctOption);
          return { ...item, options, answer };
        });
      }
      function renderHistory(filter = '') {
        const history = getHistory().sort((first, second) => new Date(second.fecha) - new Date(first.fecha));
        const filterElement = $('history-student-filter');
        const list = $('history-list');
        const status = $('history-status');
        const students = [...new Set(history.map((item) => item.nombre).filter(Boolean))].sort((first, second) => first.localeCompare(second, 'es', { sensitivity: 'base' }));
        const selectedStudent = students.includes(filter) ? filter : '';
        const filtered = selectedStudent ? history.filter((item) => item.nombre === selectedStudent) : history;
        filterElement.innerHTML = '<option value="">Todos los estudiantes</option>' + students.map((student) => `<option value="${escapeHtml(student)}">${escapeHtml(student)}</option>`).join('');
        filterElement.value = selectedStudent;
         list.innerHTML = filtered.map((item) => { const challenge = item.desafio || 'analogies'; const itemTotal = challenge === 'adjectives' ? 50 : 30; return `<tr><th scope="row">${escapeHtml(item.nombre || 'Estudiante')}</th><td>${escapeHtml(challengeName(challenge))}</td><td>${item.aciertos}/${itemTotal}</td><td>${item.errores}</td><td><span class="level-badge">${escapeHtml(item.nivel || 'Mixto')}</span></td><td>${escapeHtml(formatResultDate(item.fecha))}</td></tr>`; }).join('');
        status.textContent = filtered.length ? `${filtered.length} resultado${filtered.length === 1 ? '' : 's'} guardado${filtered.length === 1 ? '' : 's'}.` : 'No hay resultados guardados para este filtro.';
      }
      function storeResult(result) {
        const history = getHistory().filter((item) => item.fecha !== result.fecha);
        localStorage.setItem(historyKey, JSON.stringify([result, ...history].slice(0, 100)));
        renderHistory();
      }
      function chooseQuestions(name) {
       let recentIds = [];
         try { recentIds = JSON.parse(localStorage.getItem(recentQuestionsKey()) || '[]'); } catch { recentIds = []; }
       const recent = new Set(Array.isArray(recentIds) ? recentIds : []);
       const selected = Object.entries(getQuestionPlan(name)).flatMap(([level, count]) => {
         const levelQuestions = allQuestions.filter((item) => item.difficulty === level);
         const fresh = shuffle(levelQuestions.filter((item) => !recent.has(item.id)));
          return (fresh.length >= count ? fresh : shuffle(levelQuestions)).slice(0, count);
       });
       const selectedIds = selected.map((item) => item.id);
        localStorage.setItem(recentQuestionsKey(), JSON.stringify([...selectedIds, ...recentIds].slice(0, totalQuestions)));
        return arrangeOptions(selected);
     }
       function startQuiz() {
         const name = $('student-name').value.trim() || 'Estudiante';
         selectedChallenge = getChallenge();
         if (!selectedChallenge) {
           $('challenge-selection-status').textContent = 'Selecciona Analogías o Adjetivos antes de comenzar.';
           return;
         }
         localStorage.setItem('yachay-challenge', selectedChallenge);
         allQuestions = challengeBanks[selectedChallenge] || analogies;
         totalQuestions = allQuestions.length;
         $('progress-track').setAttribute('aria-valuemax', String(totalQuestions));
         localStorage.setItem('yachay-student', name);
        activeQuestions = chooseQuestions(name); current = 0; score = 0; correct = 0; streak = 0; bestStreak = 0;
        intro.classList.add('hidden'); history.classList.add('hidden'); results.classList.add('hidden'); quiz.classList.remove('hidden'); renderQuestion();
    }
    function renderQuestion() {
      answered = false; const item = activeQuestions[current];
      $('question-number').textContent = String(current + 1).padStart(2, '0'); $('difficulty-pill').textContent = item.difficulty.toUpperCase();
       $('challenge-label').textContent = challengeName(selectedChallenge).toUpperCase();
       $('type-label').textContent = selectedChallenge === 'adjectives' ? 'TIPO DE ADJETIVO' : 'RELACIÓN';
       $('analogy-type').textContent = item.type; $('question-title').textContent = item.prompt; $('score').textContent = String(score).padStart(3, '0');
       $('tip-text').innerHTML = selectedChallenge === 'adjectives' ? `<strong>Pista:</strong><br />${escapeHtml(item.hint)}` : '<strong>Observa antes de elegir.</strong><br />Busca qué relación existe entre el primer par.';
       updateProgress(current);
      $('feedback').classList.add('hidden'); $('next-button').classList.add('hidden');
       $('options-list').innerHTML = item.options.map((option, index) => `<button class="option-button" type="button" data-index="${index}" aria-label="Opción ${String.fromCharCode(65 + index)}: ${option}"><span class="option-letter" aria-hidden="true">${String.fromCharCode(65 + index)}</span><span>${option}</span></button>`).join('');
       document.querySelectorAll('.option-button').forEach((button) => button.addEventListener('click', () => answer(Number(button.dataset.index))));
     }
     function updateProgress(completed) {
       const percentage = (completed / activeQuestions.length) * 100;
       $('progress-bar').style.width = `${percentage}%`;
       $('progress-track')?.setAttribute('aria-valuenow', String(completed));
     }
    function answer(index) {
      if (answered) return; answered = true; const item = activeQuestions[current]; const isCorrect = index === item.answer;
      document.querySelectorAll('.option-button').forEach((button, optionIndex) => { button.disabled = true; if (optionIndex === item.answer) button.classList.add('correct'); if (optionIndex === index && !isCorrect) button.classList.add('wrong'); });
      if (isCorrect) { correct++; streak++; bestStreak = Math.max(bestStreak, streak); score += 10 + Math.min(streak, 5); $('feedback-title').textContent = streak > 1 ? `¡Excelente! Racha de ${streak}` : '¡Muy bien!'; $('feedback-icon').textContent = '✓'; $('feedback').className = 'feedback correct-feedback'; } else { streak = 0; $('feedback-title').textContent = 'Casi. Sigue explorando'; $('feedback-icon').textContent = '↺'; $('feedback').className = 'feedback wrong-feedback'; }
      $('feedback-text').textContent = item.explanation; $('correct-count').textContent = correct; $('streak-count').textContent = streak; $('score').textContent = String(score).padStart(3, '0'); $('next-button').classList.remove('hidden');
       updateProgress(current + 1);
     }
    function nextQuestion() { current++; if (current >= activeQuestions.length) showResults(); else renderQuestion(); }
      async function saveResult(name) {
        const saveStatus = $('save-status');
        const result = {
          fecha: new Date().toISOString(),
          nombre: name,
          aciertos: correct,
          errores: totalQuestions - correct,
           nivel: [...new Set(activeQuestions.map((item) => item.difficulty))].length === 1 ? activeQuestions[0].difficulty : 'Mixto',
           desafio: selectedChallenge,
          porcentaje: Math.round((correct / totalQuestions) * 100),
          puntaje: score,
          tiempo: 0
        };

        storeResult(result);

        saveStatus.textContent = 'Guardando resultado...';
        saveStatus.className = 'save-status saving';

        try {
          await fetch(resultsEndpoint, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
            body: JSON.stringify(result)
          });
          saveStatus.textContent = 'Resultado guardado en Google Sheets.';
          saveStatus.className = 'save-status saved';
        } catch (error) {
          saveStatus.textContent = 'No se pudo guardar. Revisa tu conexión e inténtalo de nuevo.';
          saveStatus.className = 'save-status failed';
          console.error('Error al guardar el resultado:', error);
        }
      }

      function showResults() {
        quiz.classList.add('hidden'); results.classList.remove('hidden'); history.classList.remove('hidden');
       const name = localStorage.getItem('yachay-student') || 'estudiante';
        const previousBest = Number(localStorage.getItem(`yachay-best-score-${selectedChallenge}`) || 0);
       const isBest = score >= previousBest;
        localStorage.setItem(`yachay-best-score-${selectedChallenge}`, String(Math.max(score, previousBest)));
        $('result-name').textContent = name; $('result-challenge').textContent = challengeName(selectedChallenge).toUpperCase(); $('final-score').textContent = score;
       $('final-correct').textContent = `${correct}/${totalQuestions}`;
        $('final-percent').textContent = `${Math.round((correct / totalQuestions) * 100)}%`;
        $('final-streak').textContent = bestStreak;
        $('best-result').classList.toggle('hidden', !isBest);
        saveResult(name);
      }
     function toggleSound() {
       if (!audioContext) {
          const AudioCtor = window.AudioContext || window.webkitAudioContext;
         if (!AudioCtor) return;
         audioContext = new AudioCtor(); masterGain = audioContext.createGain(); masterGain.gain.value = 0.025; masterGain.connect(audioContext.destination);
         const osc = audioContext.createOscillator(); osc.type = 'sine'; osc.frequency.value = 196;
         const lfo = audioContext.createOscillator(); const lfoGain = audioContext.createGain(); lfo.frequency.value = 0.08; lfoGain.gain.value = 5; lfo.connect(lfoGain); lfoGain.connect(osc.frequency); osc.connect(masterGain); osc.start(); lfo.start();
       }
       if (audioContext.state === 'suspended') audioContext.resume(); soundOn = !soundOn; masterGain.gain.value = soundOn ? 0.025 : 0; $('sound-toggle').setAttribute('aria-pressed', String(soundOn)); $('sound-label').textContent = soundOn ? 'Sonido activo' : 'Ambiente sonoro';
     }
      $('student-name').value = localStorage.getItem('yachay-student') || '';
      document.querySelectorAll('input[name="challenge"]').forEach((option) => option.addEventListener('change', (event) => {
        const challenge = event.target.value;
        $('start-button').classList.remove('hidden');
        $('challenge-selection-status').textContent = `Desafío seleccionado: ${challengeName(challenge)}. Ya puedes comenzar.`;
      }));
     $('history-student-filter').addEventListener('change', (event) => renderHistory(event.target.value));
     renderHistory();
     $('start-button').addEventListener('click', startQuiz); $('next-button').addEventListener('click', nextQuestion); $('restart-button').addEventListener('click', startQuiz); $('sound-toggle').addEventListener('click', toggleSound); $('print-button').addEventListener('click', () => window.print());
    $('student-name').addEventListener('keydown', (event) => { if (event.key === 'Enter') startQuiz(); });
  </script>
</MainLayout>
